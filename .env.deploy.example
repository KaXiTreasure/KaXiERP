KAXI_ENV=production
KAXI_SECRET_KEY=replace-with-at-least-50-random-characters
KAXI_DEBUG=false
KAXI_ALLOWED_HOSTS=*
KAXI_HTTPS_ENABLED=false
KAXI_DB_NAME=kaxi_erp
KAXI_DB_USER=kaxi_app
KAXI_DB_PASSWORD=replace-with-a-strong-database-password
KAXI_DB_HOST=postgres
KAXI_DB_PORT=5432
KAXI_REDIS_URL=redis://redis:6379/0
KAXI_S3_ENDPOINT=http://minio:9000
KAXI_S3_ACCESS_KEY=replace-with-minio-access-key
KAXI_S3_SECRET_KEY=replace-with-minio-secret-key
KAXI_S3_BUCKET=kaxi-documents
KAXI_HTTP_PORT=8088

# Every deployable image must be repository@sha256:digest, never a mutable tag.
KAXI_BACKEND_IMAGE=docker.io/kaxitreasure/kaxierp@sha256:copy-from-release-images.env
KAXI_WEB_IMAGE=docker.io/kaxitreasure/kaxierp@sha256:copy-from-release-images.env
KAXI_POSTGRES_IMAGE=docker.io/library/postgres@sha256:e38411452a464af89e5adadb8d223bf53b898d47d6ef918b2d58c08707350449
KAXI_REDIS_IMAGE=docker.io/library/redis@sha256:ddd16a9b1575a774c7e62956be8daa1de5b32cfb5c25b7a216aefed8e0919f9b
KAXI_MINIO_IMAGE=docker.io/minio/minio@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
KAXI_MINIO_CLIENT_IMAGE=docker.io/minio/mc@sha256:aead63c77f9db9107f1696fb08ecb0faeda23729cde94b0f663edf4fe09728e3
